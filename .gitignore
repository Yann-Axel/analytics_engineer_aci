# ──────────────────────────────────────────────────────────────────────────────
# Air Côte d'Ivoire — Git exclusions
#
# Goal: a clean clone should be ~20 MB. Everything excluded here is either
# regenerated by the pipeline (warehouse, dbt artefacts) or installed by pip
# (.venv with torch + transformers + scipy = ~1.4 GB on Windows).
# ──────────────────────────────────────────────────────────────────────────────

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# dbt build artefacts (regenerated by `dbt run`)
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
dbt_project/.user.yml

# Local DuckDB warehouse (regenerated by the pipeline)
data/aci.duckdb
data/aci.duckdb.wal

# Reviewer-produced visual deliverables — keep the folders, ignore contents
# until they are explicitly committed.
docs/screenshots/*
!docs/screenshots/.gitkeep
docs/videos/*
!docs/videos/.gitkeep

# Hugging Face / transformers model cache
.cache/
hf_cache/

# IDE / editor noise
.vscode/
.idea/
*.swp
*.swo
*.bak
*~

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Logs and temp scratch
*.log
.test_*.log
