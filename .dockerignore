# Exclude artifacts that would either bloat the image or contradict the
# reproducibility story (the image must build the warehouse itself).

# Virtualenvs
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# dbt build artefacts (regenerated by `dbt run`)
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/

# Local DuckDB warehouse (regenerated by the pipeline)
data/aci.duckdb
data/aci.duckdb.wal

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker meta
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation that the image doesn't need at runtime
docs/screenshots/
docs/videos/
*.log
